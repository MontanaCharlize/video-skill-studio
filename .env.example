# 复制成同一目录下的 .env，修改后重启网站。真实 Key 只填在 .env。

# DeepSeek：风格对话、自动分镜、按意见改镜头。
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# MiniMax H3：生成视频镜头。使用已开通视频能力的 API Key。
# 中国站：https://platform.minimax.cn/console/keys
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
# 国际站 Key 对应 https://api.minimax.io
MINIMAX_VIDEO_RESOLUTION=768P
# MiniMax-H3 可选 768P 或 2K，最终合成输出规格由片语控制。
# 离线分镜与程序图解可将两枚 Key 留空。

# 可选本地依赖。Windows 路径用正斜杠，路径含空格可加双引号。
# VIDEO_FFMPEG_DIR=C:/Tools/ffmpeg/bin
# VIDEO_FONT=C:/Windows/Fonts/msyh.ttc
# VIDEO_FONT_BOLD=C:/Windows/Fonts/msyhbd.ttc
# VIDEO_FONT_INDEX=0
# VIDEO_TTS_MODEL=E:/models/zh_CN-huayan-medium.onnx
# VIDEO_STUDIO_DATA=E:/pianyu-data
